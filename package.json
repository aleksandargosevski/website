    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/fontaine": "^0.5.0",
    "@nuxtjs/html-validator": "^2.1.0",
    "@nuxtjs/seo": "^5.3.16",
    "@vueuse/nuxt": "^15.0.0",
    "better-sqlite3": "^13.0.3",
